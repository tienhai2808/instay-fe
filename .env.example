# Copy to .env.local for local Next.js development.
# NEXT_PUBLIC_* values are visible in the browser. Never put private credentials here.
# For Docker/CI, supply public variables at image build time (see Dockerfile/workflow).

# Browser-accessible backend URL; local backend has no reverse-proxy /api prefix.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Firebase web app configuration (fill with your development Firebase project).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Optional overrides. Leave empty to derive these URLs from NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_WEBSOCKET_URL=
NEXT_PUBLIC_SSE_URL=
NEXT_PUBLIC_SSE_ENABLED=true

# Optional public storage prefix; leave empty to use the application's default.
NEXT_PUBLIC_GCS_PUBLIC_PREFIX=

# Faro telemetry (enable only when a collector is available).
NEXT_PUBLIC_FARO_ENABLED=false
NEXT_PUBLIC_FARO_URL=http://localhost:12347/collect
NEXT_PUBLIC_FARO_API_KEY=
NEXT_PUBLIC_FARO_APP_NAME=instay-fe
NEXT_PUBLIC_FARO_APP_VERSION=local
NEXT_PUBLIC_FARO_RELEASE=local
NEXT_PUBLIC_FARO_ENVIRONMENT=local
NEXT_PUBLIC_FARO_CAPTURE_CONSOLE=false

# Optional deployment commit metadata, used as a version/release fallback.
NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=
